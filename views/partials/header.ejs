<!DOCTYPE html>
<!--
  File name  : header.ejs
  Student    : Wu Yi
  Student ID : 2024110099
  Date       : 2026-10-29
  Description: Shared page header - contains the HTML head, Bootstrap CSS,
               the custom logo and the navigation bar used on every page.
-->
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Yi Wu - Portfolio</title>
    <!-- Bootstrap CSS from CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons from CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <!-- Custom site styles -->
    <link rel="stylesheet" href="/stylesheets/style.css">
  </head>
  <body>
    <!-- ======= Navigation Bar ======= -->
    <nav class="navbar navbar-expand-lg navbar-dark site-navbar">
      <div class="container">
        <!-- Custom logo (star badge) + brand name -->
        <a class="navbar-brand" href="/">
          <img src="/images/logo.png" alt="Yi Wu Logo" class="site-logo">
          <span class="brand-text">Yi Wu</span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNav">
          <ul class="navbar-nav ms-auto">
            <li class="nav-item"><a class="nav-link <%= currentPage === 'home' ? 'active' : '' %>" href="/">Home</a></li>
            <li class="nav-item"><a class="nav-link <%= currentPage === 'about' ? 'active' : '' %>" href="/about">About</a></li>
            <li class="nav-item"><a class="nav-link <%= currentPage === 'projects' ? 'active' : '' %>" href="/projects">Projects</a></li>
            <li class="nav-item"><a class="nav-link <%= currentPage === 'services' ? 'active' : '' %>" href="/services">Services</a></li>
            <li class="nav-item"><a class="nav-link <%= currentPage === 'contact' ? 'active' : '' %>" href="/contact">Contact</a></li>
          </ul>
        </div>
      </div>
    </nav>
    <!-- ======= End Navigation Bar ======= -->
