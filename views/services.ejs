<% var title = 'Services'; %>
<%- include('partials/header', { currentPage: 'services' }) %>

<!-- ======= Services Section ======= -->
<main>
  <section class="container section">
    <h2 class="section-title">Services</h2>
    <p class="section-sub">A few services I can offer to help bring your ideas to life.</p>

    <div class="row g-4">
      <!-- Service 1 -->
      <div class="col-md-4">
        <div class="card service-card h-100">
