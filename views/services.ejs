        </div>
      </div>
      <!-- Service 2 -->
      <div class="col-md-4">
        <div class="card service-card h-100">
          <div class="service-icon"><i class="bi bi-code-slash"></i></div>
          <div class="card-body">
            <h5 class="card-title">General Programming</h5>
            <p class="card-text">Writing clean, well-documented code in languages such as JavaScript, Python and SQL.</p>
          </div>
        </div>
      </div>
      <!-- Service 3 -->
      <div class="col-md-4">
        <div class="card service-card h-100">
          <div class="service-icon"><i class="bi bi-phone"></i></div>
          <div class="card-body">
            <h5 class="card-title">Mobile-Friendly Apps</h5>
            <p class="card-text">Designing applications that look and work well on phones, tablets and desktops.</p>
          </div>
        </div>
      </div>
    </div>
